{
  "$schema": "./schema.json",
  "schemaVersion": 2,
  "marketplace": {
    "id": "bharath-agent-plugins",
    "name": "bharath-agent-plugins",
    "owner": {
      "name": "Bharath Kumar Ravichandran"
    },
    "description": "Bharath's portable plugins and skills for coding agents."
  },
  "sources": [
    {
      "id": "cursor-plugins",
      "kind": "git-submodule",
      "path": "vendor/cursor-plugins",
      "upstream": "https://github.com/cursor/plugins.git",
      "branch": "main"
    },
    {
      "id": "local-plugins",
      "kind": "curated-copy",
      "path": "plugins",
      "upstream": "https://github.com/multica-ai/andrej-karpathy-skills.git"
    }
  ],
  "plugins": [
    {
      "id": "pstack",
      "source": "cursor-plugins",
      "artifacts": {
        "cursor-plugin": { "path": "pstack" },
        "claude-plugin": { "path": "harness/pstack/claude-code" },
        "agent-skills": { "path": "pstack/skills" }
      },
      "provenance": {
        "upstream": "https://github.com/cursor/plugins/tree/main/pstack"
      }
    },
    {
      "id": "karpathy-guidelines",
      "source": "local-plugins",
      "artifacts": {
        "cursor-plugin": { "path": "karpathy-guidelines" },
        "claude-plugin": { "path": "karpathy-guidelines" },
        "agent-skills": { "path": "karpathy-guidelines/skills" }
      },
      "provenance": {
        "upstream": "https://github.com/multica-ai/andrej-karpathy-skills/blob/main/skills/karpathy-guidelines/SKILL.md",
        "notice": "plugins/karpathy-guidelines/NOTICE.md"
      }
    }
  ]
}
