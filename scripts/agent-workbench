#!/bin/sh
# Transition wrapper for the default Rust CLI.
# This script is not $PREFIX/bin/agent-workbench and must not be installed
# in its place.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

resolve() {
    if [ -n "${AGENT_WORKBENCH_BIN:-}" ]; then
        printf '%s\n' "$AGENT_WORKBENCH_BIN"
        return 0
    fi
    if [ -x "$ROOT/target/release/agent-workbench" ]; then
        printf '%s\n' "$ROOT/target/release/agent-workbench"
        return 0
    fi
    if [ -x "$ROOT/target/debug/agent-workbench" ]; then
        printf '%s\n' "$ROOT/target/debug/agent-workbench"
        return 0
    fi
    printf '%s\n' "agent-workbench: default Rust CLI is missing. Install with make rust-release PREFIX=\"\$HOME/.local\" or build target/debug/agent-workbench." >&2
    return 127
}

BIN=$(resolve)
exec "$BIN" "$@"
