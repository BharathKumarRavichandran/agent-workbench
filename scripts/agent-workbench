#!/bin/sh
# Transition wrapper for the default Rust CLI.
# The Python module form remains the frozen oracle until F8.
# This script is not $PREFIX/bin/agent-workbench and must not be installed
# in its place.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

resolve() {
    if [ -n "${AGENT_WORKBENCH_BIN:-}" ]; then
        printf '%s\n' "$AGENT_WORKBENCH_BIN"
        return 0
    fi
    if [ -x "$ROOT/rust/target/release/agent-workbench-rs" ]; then
        printf '%s\n' "$ROOT/rust/target/release/agent-workbench-rs"
        return 0
    fi
    if [ -x "$ROOT/rust/target/debug/agent-workbench-rs" ]; then
        printf '%s\n' "$ROOT/rust/target/debug/agent-workbench-rs"
        return 0
    fi
    printf '%s\n' "agent-workbench: default Rust CLI is missing. Install with python3 scripts/package_release.py --prefix \"\$HOME/.local\" or build rust/target/debug/agent-workbench-rs." >&2
    return 127
}

BIN=$(resolve)
exec "$BIN" "$@"
